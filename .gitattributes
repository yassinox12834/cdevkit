# Line endings
*.bat     text eol=crlf
*.py      text eol=lf
*.md      text eol=lf
*.sh      text eol=lf
*.command text eol=lf

# GitHub language statistics
# GitHub treats folders named examples/ as documentation and skips them.
# Force the example programs to count, with an explicit language per file.
examples/c/*.c     linguist-language=C   linguist-documentation=false linguist-vendored=false
examples/cpp/*.cpp linguist-language=C++ linguist-documentation=false linguist-vendored=false
*.c   linguist-detectable=true
*.cpp linguist-detectable=true

# .command files (macOS launchers) are shell scripts, but GitHub does not recognise the extension.
*.command linguist-language=Shell

# Optional: also count Markdown. Remove the # on the next line if you want it in the bar.
# *.md linguist-detectable=true